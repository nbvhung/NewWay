# ============================================================
# NewWay — Environment cho instance TEST bot AI (Gemini)
# Sao chép thành be/.env.aitest và điền giá trị thật.
# KHÔNG commit file .env.aitest (đã nằm trong .gitignore).
# Instance này chạy hoàn toàn tách biệt khỏi hệ thống production.
# ============================================================

PORT=4100
NODE_ENV=development

# DB riêng (tạo trước: CREATE DATABASE newway_ai;)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=newway_ai
DB_SSL=false

# Redis riêng (chạy instance riêng ở cổng 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT test (giá trị bất kỳ, chỉ dùng cho instance test)
JWT_ACCESS_SECRET=ai_test_access_secret_0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=ai_test_refresh_secret_0123456789abcdef0123456789abc
CORS_ORIGIN=http://localhost:3000

# Bot test: chỉ đặt token bot dùng để test AI, KHÔNG đặt token production
ZALO_BOT_TOKEN=<token bot test>
ZALO_POLLING=true
ZALO_WEBHOOK_SECRET=ai_test_webhook_secret_0123456789

# AI (Gemini)
ZALO_AI_ENABLED=true
GEMINI_API_KEY=<GEMINI_API_KEY>
# Free tier không dùng được Pro (quota 0). Flash ổn cho test:
GEMINI_MODEL=gemini-3.5-flash
# Nâng gói trả phí rồi muốn dùng Pro: gemini-3.1-pro-preview
# ZALO_AI_SYSTEM_PROMPT=Bạn là trợ lý ảo... (tuỳ chọn, ghi đè prompt mặc định)